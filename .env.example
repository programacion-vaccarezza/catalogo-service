POSTGRES_DB=catalogo_db
POSTGRES_USER=catalogo_user
POSTGRES_PASSWORD="Contraseña de la base de datos"
DB_PORT=5433

DB_URL=jdbc:postgresql://127.0.0.1:5433/catalogo_db
DB_USERNAME=catalogo_user
DB_PASSWORD="Contraseña de la base de datos"
JWT_SECRET="Clave secreta para firmar los JWT"
JWT_EXPIRATION="Tiempo de duración del token"

SERVICE_CLIENT_ID=turnos-service
SERVICE_CLIENT_SECRET="Secreto de la cuenta técnica de turnos-service"
SERVICE_JWT_SECRET="Clave secreta para firmar los JWT técnicos (distinta de JWT_SECRET)"
SERVICE_JWT_EXPIRATION="Tiempo de duración del token técnico"

CATEDRA_BASE_URL="URL base de la API REST de la cátedra"
CATEDRA_JWT="JWT técnico de la cuenta de integración contra la cátedra (1 año de vigencia)"
CATEDRA_GROUP_ID="groupId normalizado de la cuenta de integración"
CATEDRA_REDIS_HOST="Host de Redis de la cátedra"
CATEDRA_REDIS_PORT="Puerto de Redis de la cátedra"
CATEDRA_REDIS_USERNAME="Usuario de Redis de la cátedra"
CATEDRA_REDIS_PASSWORD="Contraseña de Redis de la cátedra"
CATEDRA_REDIS_READ_NAMESPACE="Namespace de Redis que la cátedra publica para sincronización (catedra:sync:*)"
CATEDRA_KAFKA_BOOTSTRAP_SERVERS="Bootstrap servers de Kafka de la cátedra"
CATEDRA_KAFKA_CONSUMER_GROUP_ID="Consumer group id asignado a la cuenta de integración"
CATEDRA_KAFKA_CATALOG_TOPIC="Topic de Kafka donde la cátedra notifica CatalogUpdated"
